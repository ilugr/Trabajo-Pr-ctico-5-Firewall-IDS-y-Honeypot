# Reglas locales de respaldo del TP5.
# Garantizan que el escaneo nmap produzca alertas aunque la descarga de
# Emerging Threats Open (suricata-update) no este disponible en el build.
# Las reglas ET Open se cargan ademas desde suricata.rules.

# Muchos SYN desde el mismo origen en poco tiempo = SYN scan.
alert tcp any any -> $HOME_NET any (msg:"TP5 LOCAL SCAN - SYN scan (many SYNs from one source)"; flags:S; flow:stateless; detection_filter:track by_src, count 5, seconds 10; sid:9000001; rev:1;)

# Huella del string "NMAP" en probes de version detection.
alert tcp any any -> $HOME_NET any (msg:"TP5 LOCAL SCAN - NMAP banner/probe string"; content:"|4e 4d 41 50|"; nocase; sid:9000002; rev:1;)
